DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=60
ALLOWED_ORIGINS=http://localhost:3000
DEBUG=true
JWT_SECRET_KEY=change-this-in-your-local-env
JWT_EXPIRE_MINUTES=60
ADMIN_COOKIE_NAME=vehicle_admin_token
# Set true in HTTPS production. Keep false for local http://localhost development.
ADMIN_COOKIE_SECURE=false
ADMIN_COOKIE_SAMESITE=lax
# Used only by scripts/seed_admin.py; never expose public admin registration.
INITIAL_ADMIN_NAME=Admin User
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
INITIAL_ADMIN_ROLE=admin
# Prefer Alembic migrations. Set true only to bootstrap tables without alembic.
AUTO_CREATE_TABLES=false
