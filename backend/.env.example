# PostgreSQL (required)
# Local example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vehicle_recommendation
# Production: prefer SSL via query string or DATABASE_SSL_MODE, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Never commit real credentials.

# Optional when sslmode is not in DATABASE_URL (libpq): require | verify-full | ...
DATABASE_SSL_MODE=

# Gemini (required for NL extraction / AI explanations)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=60

# CORS — comma-separated frontend origins (include production frontend URL)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security
# Use a long random string (24+ characters). Never commit the real value.
JWT_SECRET_KEY=replace-with-a-long-random-secret-key
JWT_EXPIRE_MINUTES=60
ADMIN_COOKIE_NAME=vehicle_admin_token
# Set true behind HTTPS in production. Keep false for local http://localhost.
ADMIN_COOKIE_SECURE=false
ADMIN_COOKIE_SAMESITE=lax

# Runtime
# Keep false in production (hides OpenAPI docs and internal error details).
DEBUG=false
# Fail startup when PostgreSQL is unreachable (recommended).
REQUIRE_DB_ON_STARTUP=true
# Prefer Alembic migrations. Set true only to bootstrap tables without alembic.
AUTO_CREATE_TABLES=false
# Reject request bodies larger than this many bytes (default 1 MiB).
MAX_REQUEST_BODY_BYTES=1048576

# Admin seed script only (scripts/seed_admin.py) — never used by public registration.
INITIAL_ADMIN_NAME=Admin User
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
INITIAL_ADMIN_ROLE=admin
