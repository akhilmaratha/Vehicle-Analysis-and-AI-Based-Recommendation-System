          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles?transmission=Automatic",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles"],
              "query": [{ "key": "transmission", "value": "Automatic" }]
            }
          }
        },
        {
          "name": "07 Filter by price range",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Price within range', function () {",
                  "  const body = pm.response.json();",
                  "  body.items.forEach(function (v) {",
                  "    pm.expect(v.price).to.be.at.least(500000);",
                  "    pm.expect(v.price).to.be.at.most(1500000);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles?min_price=500000&max_price=1500000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles"],
              "query": [
                { "key": "min_price", "value": "500000" },
                { "key": "max_price", "value": "1500000" }
              ]
            }
          }
        },
        {
          "name": "08 Sort vehicles by price",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Prices ascending', function () {",
                  "  const body = pm.response.json();",
                  "  const prices = body.items.map(v => Number(v.price));",
                  "  const sorted = [...prices].sort((a, b) => a - b);",
                  "  pm.expect(prices).to.eql(sorted);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles?sort_by=price&sort_order=asc&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles"],
              "query": [
                { "key": "sort_by", "value": "price" },
                { "key": "sort_order", "value": "asc" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        }
      ]
    },
