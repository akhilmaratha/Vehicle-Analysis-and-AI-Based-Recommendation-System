                  "});",
                  "pm.test('All items match brand when present', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('items');",
                  "  body.items.forEach(function (v) {",
                  "    pm.expect(v.brand.toLowerCase()).to.eql('hyundai');",
